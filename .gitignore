# Ignore everything
*

# Allow root-level files
!/*

# Allow specific configuration files
!emacs.org
!init.el
!early-init.el
!custom.el
!README.org

# Allow custom directories
!/lisp/
!/lisp/**
!/snippets/
!/snippets/**

# Explicitly exclude dasker/joe og config
/dasker-setup/
/joe-setup/

# Explicitly exclude generated directories
/straight/
/var/
/tmp/
/auto-save-list/
/elpa/
/transient/
/eln-cache/
